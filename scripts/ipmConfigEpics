#!/bin/bash

export EPICS_CA_MAX_ARRAY_BYTES=8388608
ulimit -c unlimited

em3l0='em3l0'
um6Ipm='hxxdg1_ipm um6_dio'
dg2Ipm='hfxdg2_ipm'
xcsIpm='decmono ipmmono diomono pim3 pim3m ipm3 pim4 ipm4 snddio ipm5 pim5 ipmgonLD ipmlamLD usrdio'
xppIpm='diomono decmono ipm2 ipm3 pim3 diodeU'
cxiIpm='pim3m dg2ipm dg3ipm usrdio'
mfxIpm='dg1ipm dg2ipm usrdio'
mecIpm='ipm1 ipm2 ipm3 hxm_pim pim2 pim3 tc1_imb1 usr_imb1 usr_imb2 las_imb1 las_imb2 usr_dio xrt_hrm'
lfeIpm='hfxdg2_ipm pim3m xrt_hrm'

usage()
{
    cat << EOF
usage: $0 [-b boxname] [-H hutch] [-d] [-h] [-l]

Displays a GUI for the selected IPM.
Running without arguments allows for box selection.

OPTIONS:
-b: specify boxname to view
-H: specify a hutch, overriding automated selection
-d: fix known Bld Damage issues
-h: display this help text
-l: list available boxnames
EOF
}


get_hutch()
{
    local detected

    if [[ -n "${HUTCH:-}" ]]; then
        detected="$HUTCH"
    else
        if ! detected=$(get_info --gethutch); then
            echo "Error: Could not determine hutch using get_info." >&2
            return 1
        fi
    fi

    hutch=${detected,,}

    case "$hutch" in
        xcs|xpp|cxi|mfx|mec|lfe)
            HUTCH=${hutch^^}
            ;;
        *)
            printf "Error: Unknown or unsupported hutch '%s'. Use -H to select a hutch.\n" \
                "$detected" >&2
            return 1
            ;;
    esac
}


ipmList()
{
    local boxes
    local box

    case "$hutch" in
        xcs)
            boxes="$em3l0 $um6Ipm $dg2Ipm $xcsIpm"
            ;;
        xpp)
            boxes="$em3l0 $xppIpm"
            ;;
        cxi)
            boxes="$em3l0 $um6Ipm $lfeIpm $cxiIpm"
            ;;
        mfx)
            boxes="$em3l0 $um6Ipm $mfxIpm"
            ;;
        mec)
            boxes="$em3l0 $um6Ipm $mecIpm"
            ;;
        lfe)
            boxes="$em3l0 $um6Ipm $lfeIpm"
            ;;
        *)
            echo "Error: Hutch cannot be determined." >&2
            return 1
            ;;
    esac

    printf 'Possible boxes for %s:\n' "$hutch"

    # Intentional word splitting of the space-separated box list.
    for box in $boxes; do
        printf '%s\n' "$box"
    done
}


ipmSetEnvPars()
{
    if [[ $# -ne 1 || -z "$1" ]]; then
        echo "Error: A boxname is required." >&2
        return 1
    fi

    local box="$1"

    # Clear inherited or previously selected configuration.
    BASE=''
    IOC=''
    EVR=''
    TPR=''
    NN=''
    WAVE8=''
    WAVE8V3=''

    # Shared IPMs.
    case "$box" in
        em3l0)
            BASE='EM3L0:IPM:W8:01'
            WAVE8V3='em3l0'
            ;;
        hxxdg1_ipm)
            # XRT IPM1.
            IOC='IOC:HXX:DG1:BMMON'
            BASE='HXX:DG1:BMMON'
            TPR='XRT:TPR:01'
            NN='03'
            WAVE8='hxxipm'
            ;;
        xrt_hrm)
            # MEC HRM.
            IOC='IOC:XRT:HRM:DG:01'
            BASE='XRT:HRM:DG:01'
            TPR='XRT:TPR:01'
            NN='05'
            WAVE8='xrt_hrm'
            ;;
        um6_dio)
            # XRT YAG1 diode.
            BASE='XCS:DG1:IMB:02'
            IOC='XCS:R04:IOC:34'
            EVR='XCS:R04:EVR:34'
            ;;
        hfxdg2_ipm)
            # XRT IPM2.
            IOC='IOC:HFX:DG2:BMMON'
            BASE='HFX:DG2:BMMON'
            TPR='XRT:TPR:01'
            NN='01'
            WAVE8='hfxipm'
            ;;
        pim3m)
            BASE='HFX:DG3:IMB:02'
            IOC='XCS:R38:IOC:43'
            EVR='XCS:R38:EVR:43'
            ;;
    esac

    # Shared configuration is complete.
    if [[ -n "$BASE" ]]; then
        return 0
    fi

    # Hutch-specific IPMs.
    case "$hutch" in
        xcs)
            case "$box" in
                decmono)
                    BASE='HFX:MON:IMB:03'
                    IOC='XCS:R38:IOC:43'
                    EVR='XCS:R38:EVR:43'
                    ;;
                diomono)
                    BASE='HFX:MON:IMB:02'
                    IOC='XCS:R38:IOC:43'
                    EVR='XCS:R38:EVR:43'
                    ;;
                ipmmono)
                    BASE='HFX:MON:IMB:01'
                    IOC='XCS:R38:IOC:43'
                    EVR='XCS:R38:EVR:43'
                    ;;
                pim3)
                    BASE='XCS:DG3:IMB:04'
                    IOC='XCS:R38:IOC:43'
                    EVR='XCS:R38:EVR:43'
                    ;;
                ipm3)
                    BASE='XCS:DG3:IMB:03'
                    IOC='XCS:R38:IOC:43'
                    EVR='XCS:R38:EVR:43'
                    ;;
                ipm4)
                    IOC='IOC:XCS:SB1:BMMON'
                    BASE='XCS:SB1:BMMON'
                    EVR='XCS:SB1:BMMON:EVR'
                    WAVE8='sb1bmmon'
                    ;;
                pim4)
                    BASE='XCS:SB1:IMB:02'
                    IOC='IOC:XCS:IPM'
                    EVR='XCS:R44:EVR:01'
                    ;;
                ipm5)
                    IOC='IOC:XCS:SB2:BMMON'
                    BASE='XCS:SB2:BMMON'
                    EVR='XCS:SB2:BMMON:EVR'
                    WAVE8='sb2bmmon'
                    ;;
                usrdio)
                    IOC='IOC:XCS:USR:DIO'
                    BASE='XCS:USR:DIO'
                    EVR='XCS:USR:DIO:EVR'
                    WAVE8='usrdio'
                    ;;
                pim5)
                    BASE='XCS:SB2:IMB:02'
                    IOC='IOC:XCS:IPM'
                    EVR='XCS:R44:EVR:01'
                    ;;
                ipmgonLD)
                    BASE='XCS:USR:IMB:01'
                    IOC='IOC:XCS:USR:IPM'
                    EVR='XCS:R42:EVR:01'
                    ;;
                ipmlamLD)
                    BASE='XCS:LAM:IMB:02'
                    IOC='IOC:XCS:IPM'
                    EVR='XCS:R44:EVR:01'
                    ;;
                snddio)
                    IOC='IOC:XCS:SND:DIO'
                    BASE='XCS:SND:DIO'
                    EVR='XCS:SND:DIO:EVR'
                    WAVE8='snddio'
                    ;;
            esac
            ;;

        cxi)
            case "$box" in
                dg2ipm)
                    IOC='IOC:CXI:DG2:BMMON'
                    BASE='CXI:DG2:BMMON'
                    EVR='CXI:DG2:BMMON:EVR'
                    WAVE8='dg2ipm'
                    ;;
                dg3ipm)
                    IOC='IOC:CXI:DG3:BMMON'
                    BASE='CXI:DG3:BMMON'
                    EVR='CXI:DG3:BMMON:EVR'
                    WAVE8='dg3ipm'
                    ;;
                usrdio)
                    IOC='IOC:CXI:USR:DIO'
                    BASE='CXI:USR:DIO'
                    EVR='CXI:USR:DIO:EVR'
                    WAVE8='usrdio'
                    ;;
            esac
            ;;

        mfx)
            case "$box" in
                dg1ipm)
                    IOC='IOC:MFX:DG1:BMMON'
                    BASE='MFX:DG1:BMMON'
                    EVR='MFX:DG1:BMMON:EVR'
                    WAVE8='dg1ipm'
                    ;;
                dg2ipm)
                    IOC='IOC:MFX:DG2:BMMON'
                    BASE='MFX:DG2:BMMON'
                    EVR='MFX:DG2:BMMON:EVR'
                    WAVE8='dg2ipm'
                    ;;
                usrdio)
                    IOC='IOC:MFX:USR:DIO'
                    BASE='MFX:USR:DIO'
                    EVR='MFX:USR:DIO:EVR'
                    WAVE8='usrdio'
                    ;;
                dg1ipmV3)
                    IOC='IOC:MFX:DG1:W8:01'
                    BASE='MFX:DG1:W8:01'
                    WAVE8='dg1ipmV3'
                    # No timing configuration was provided for this box.
                    # Configure EVR or TPR/NN before using the wave8 GUI.
                    ;;
            esac
            ;;

        xpp)
            case "$box" in
                diomono)
                    IOC='IOC:XPP:IPM'
                    BASE='XPP:MON:IPM:02'
                    EVR='XPP:IPM:EVR'
                    ;;
                decmono)
                    IOC='IOC:XPP:IPM'
                    BASE='XPP:MON:IPM:01'
                    EVR='XPP:IPM:EVR'
                    ;;
                ipm2)
                    IOC='IOC:XPP:SB2:BMMON'
                    BASE='XPP:SB2:BMMON'
                    EVR='XPP:SB2:BMMON:EVR'
                    WAVE8='sb2bmmon'
                    ;;
                ipm3)
                    IOC='IOC:XPP:SB3:BMMON'
                    BASE='XPP:SB3:BMMON'
                    EVR='XPP:SB3:BMMON:EVR'
                    WAVE8='sb3bmmon'
                    ;;
                pim3)
                    IOC='IOC:XPP:IPM'
                    BASE='XPP:SB3:IPM:02'
                    EVR='XPP:IPM:EVR'
                    ;;
                diodeU)
                    IOC='IOC:XPP:IPM'
                    BASE='XPP:USR:IPM:01'
                    EVR='XPP:IPM:EVR'
                    ;;
            esac
            ;;

        mec)
            case "$box" in
                ipm1)
                    IOC='XRT:R33:IOC:39'
                    BASE='MEC:HXM:IPM:01'
                    EVR='XRT:R44:EVR:39'
                    ;;
                hxm_pim)
                    IOC='XRT:R33:IOC:39'
                    BASE='MEC:HXM:PIM:01'
                    EVR='XRT:R44:EVR:39'
                    ;;
                pim2)
                    IOC='IOC:MEC:IMB02'
                    BASE='MEC:XT2:PIM:02'
                    EVR='MEC:XT2:EVR:01'
                    ;;
                pim3)
                    IOC='IOC:MEC:IMB02'
                    BASE='MEC:XT2:PIM:03'
                    EVR='MEC:XT2:EVR:01'
                    ;;
                tc1_imb1)
                    IOC='IOC:MEC:IPIMB01'
                    EVR='MEC:TC1:EVR:01'
                    BASE='MEC:TC1:IMB:01'
                    ;;
                usr_imb1)
                    IOC='IOC:MEC:IPIMB01'
                    EVR='MEC:TC1:EVR:01'
                    BASE='MEC:USR:IMB:01'
                    ;;
                usr_imb2)
                    IOC='IOC:MEC:IPIMB01'
                    EVR='MEC:TC1:EVR:01'
                    BASE='MEC:USR:IMB:02'
                    ;;
                las_imb1)
                    IOC='IOC:MEC:IPIMB01'
                    EVR='MEC:TC1:EVR:01'
                    BASE='MEC:LAS:IMB:01'
                    ;;
                las_imb2)
                    IOC='IOC:MEC:IPIMB01'
                    EVR='MEC:TC1:EVR:01'
                    BASE='MEC:LAS:IMB:02'
                    ;;
                ipm2)
                    IOC='IOC:MEC:XT2-1:BMMON'
                    EVR='MEC:XT2-1:BMMON:EVR'
                    BASE='MEC:XT2-1:BMMON'
                    WAVE8='xt2-1bmmon'
                    ;;
                ipm3)
                    IOC='IOC:MEC:XT2-2:BMMON'
                    EVR='MEC:XT2-2:BMMON:EVR'
                    BASE='MEC:XT2-2:BMMON'
                    WAVE8='xt2-2bmmon'
                    ;;
                usr_dio)
                    IOC='IOC:MEC:USR:DIO'
                    EVR='MEC:USR:DIO:EVR'
                    BASE='MEC:USR:DIO'
                    WAVE8='usr-dio'
                    ;;
            esac
            ;;
    esac

    if [[ -z "$BASE" ]]; then
        printf "Unknown box '%s' for hutch '%s'.\n" "$box" "$hutch" >&2
        echo "Use -l to list available boxes." >&2
        return 1
    fi

    return 0
}


# Read the :SUM PV and open the appropriate GUI if connected.
ipmGUI()
{
    local HERE
    local cmdName
    local -a wave8_args

    HERE="$(realpath "$(dirname "${BASH_SOURCE[0]}")")" || return 1
    source "${HERE}/ctrlenv_setup.sh" || return 1
    ctrlenv-pathmunge ipm_config || return 1

    if ! caget "${BASE}:SUM" > /dev/null 2>&1; then
        echo "Could not connect to ${BASE}. Exiting..." >&2
        return 1
    fi

    if [[ -n "$WAVE8V3" ]]; then
        cmdName=$(caget -St "${BASE}:LAUNCH_EDM") || return 1

        # Allow only alphanumeric characters, underscore, dash, slash, period.
        if [[ "$cmdName" =~ ^[a-zA-Z0-9_./-]+$ ]]; then
            echo "Calling EDM main screen from: $cmdName"
            "$cmdName"
        else
            echo "Error: Unsafe command detected in LAUNCH_EDM PV: '$cmdName'." >&2
            return 1
        fi

    elif [[ -n "$WAVE8" ]]; then
        if [[ -n "$TPR" && -n "$EVR" ]]; then
            echo "Error: Both TPR and EVR are configured for '$BOXNAME'." >&2
            echo "Configure only one timing system." >&2
            return 1
        fi

        wave8_args=(--base "$BASE")

        if [[ -n "$TPR" ]]; then
            if [[ -z "$IOC" || -z "$NN" ]]; then
                echo "Error: TPR configuration for '$BOXNAME' requires IOC and NN." >&2
                return 1
            fi

            wave8_args+=(
                --ioc "$IOC"
                --tpr "$TPR"
                --nn "$NN"
            )

        elif [[ -n "$EVR" ]]; then
            wave8_args+=(--evr "$EVR")

            if [[ -n "$IOC" ]]; then
                wave8_args+=(--ioc "$IOC")
            fi

        else
            echo "Error: Neither TPR nor EVR is configured for '$BOXNAME'." >&2
            return 1
        fi

        printf 'Launching: wave8'
        printf ' %q' "${wave8_args[@]}"
        printf '\n'

        wave8 "${wave8_args[@]}"

    else
        # Existing IPIMB launch behavior.
        ipimb --base "$BASE" --ioc "$IOC" --evr "$EVR"
    fi
}


# Disable statsPlugin for known IPIMB boxes to help Bld run at 120 Hz.
helpBld()
{
    if [[ "$hutch" == 'xcs' &&
          ("$BOXNAME" == 'ipm3' || "$BOXNAME" == 'dio3') ]]; then

        caput HFX:DG3:CVV:01:Stats2:EnableCallbacks 0
        caput XCS:DG3:CVV:02:Stats2:EnableCallbacks 0

        if [[ $(caget -nt HFX:DG3:CVV:01:Stats2:EnableCallbacks 2>/dev/null) == 0 &&
              $(caget -nt XCS:DG3:CVV:02:Stats2:EnableCallbacks 2>/dev/null) == 0 ]]; then
            echo 'Turned off statsPlugin for XCS ipm3 and dio3'
        else
            echo 'Was unable to turn off statsPlugin' >&2
            return 1
        fi
    else
        echo 'Selected box has no known Bld issue to fix' >&2
        return 1
    fi
}


# Main execution.
if [[ "${1:-}" == '--help' ]]; then
    usage
    exit 0
fi

HUTCH=''
BOXNAME=''
HELPDAQBLD=0
LIST_ONLY=0

while getopts "b:H:dlh" OPTION; do
    case "$OPTION" in
        H)
            HUTCH=${OPTARG^^}
            ;;
        b)
            BOXNAME=$OPTARG
            ;;
        d)
            HELPDAQBLD=1
            ;;
        l)
            LIST_ONLY=1
            ;;
        h)
            usage
            exit 0
            ;;
        *)
            usage
            exit 1
            ;;
    esac
done

shift "$((OPTIND - 1))"

if [[ $# -gt 0 ]]; then
    printf 'Error: Unexpected argument: %s\n' "$1" >&2
    usage
    exit 1
fi

# Hutch detection must happen before looking up hutch-specific boxes.
get_hutch || exit 1

# Handle listing after parsing all options so -l and -H work in either order.
if [[ "$LIST_ONLY" -eq 1 ]]; then
    ipmList
    exit $?
fi

if [[ -z "$BOXNAME" ]]; then
    ipmList || exit 1
    printf 'Enter box name from above list:\n'
    read -r BOXNAME || exit 1
fi

ipmSetEnvPars "$BOXNAME" || exit 1

if [[ "$HELPDAQBLD" -gt 0 ]]; then
    helpBld
else
    ipmGUI
fi

exit $?
